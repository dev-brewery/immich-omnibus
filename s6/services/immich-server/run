#!/command/with-contenv sh
# Sources /data/.env for DB_PASSWORD generated by scripts/init.sh.
[ -f /data/.env ] && . /data/.env

PGBIN="/usr/lib/postgresql/17/bin"

echo "[immich-server] Waiting for PostgreSQL..."
until ${PGBIN}/pg_isready -h 127.0.0.1 -p "${DB_PORT:-5432}" -U "${DB_USERNAME:-immich}" -q 2>/dev/null; do
    s6-sleep 1
done
echo "[immich-server] PostgreSQL ready."

echo "[immich-server] Waiting for Redis..."
until nc -z 127.0.0.1 6379 2>/dev/null; do
    s6-sleep 1
done
echo "[immich-server] Redis ready."

cd /opt/immich-server
export IMMICH_PORT="${IMMICH_PORT:-2283}"
export DB_HOSTNAME="127.0.0.1"
export DB_PORT="${DB_PORT:-5432}"
export DB_USERNAME="${DB_USERNAME:-immich}"
export DB_PASSWORD="${DB_PASSWORD:-immich}"
export DB_DATABASE_NAME="${DB_DATABASE_NAME:-immich}"
export DB_VECTOR_EXTENSION="${DB_VECTOR_EXTENSION:-vectorchord}"
export REDIS_HOSTNAME="127.0.0.1"
export REDIS_PORT="6379"

exec node dist/main
