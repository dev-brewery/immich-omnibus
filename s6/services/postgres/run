#!/command/with-contenv sh
# PostgreSQL 17 from trixie apt repos. Sources /data/.env for DB_PASSWORD.
[ -f /data/.env ] && . /data/.env

PGDATA="${DB_DATA_LOCATION:-/data/postgres}"
PGBIN="/usr/lib/postgresql/17/bin"

if [ ! -f "${PGDATA}/PG_VERSION" ]; then
    echo "[postgres] Initializing database..."
    mkdir -p "${PGDATA}"
    chown -R postgres:postgres "${PGDATA}"

    s6-setuidgid postgres ${PGBIN}/initdb -D "${PGDATA}" \
        --data-checksums --encoding=UTF8 --locale=C

    echo "host all all 127.0.0.1/32 md5" >> "${PGDATA}/pg_hba.conf"
    echo "host all all ::1/128 md5" >> "${PGDATA}/pg_hba.conf"

    # Small-host tuning — targets a ~300-500MB postgres footprint.
    # Upper bound: shared_buffers + (work_mem * max_connections) + maintenance_work_mem
    #            = 128 + (4 * 20) + 64 = 272MB + OS page cache it steals.
    cat >> "${PGDATA}/postgresql.conf" <<'PGCONF'

# --- photoframe-immich small-host tuning ---
shared_preload_libraries = 'vchord.so'
shared_buffers = 128MB
work_mem = 4MB
maintenance_work_mem = 64MB
effective_cache_size = 512MB
max_connections = 20
max_wal_size = 512MB
min_wal_size = 64MB
PGCONF

    s6-setuidgid postgres ${PGBIN}/pg_ctl -D "${PGDATA}" -o "-p ${DB_PORT:-5432}" -w start

    s6-setuidgid postgres ${PGBIN}/psql -p "${DB_PORT:-5432}" -c "CREATE USER ${DB_USERNAME:-immich} WITH PASSWORD '${DB_PASSWORD:-immich}';" 2>/dev/null || true
    s6-setuidgid postgres ${PGBIN}/psql -p "${DB_PORT:-5432}" -c "CREATE DATABASE ${DB_DATABASE_NAME:-immich} OWNER ${DB_USERNAME:-immich};" 2>/dev/null || true
    s6-setuidgid postgres ${PGBIN}/psql -p "${DB_PORT:-5432}" -c "ALTER USER ${DB_USERNAME:-immich} WITH SUPERUSER;" 2>/dev/null || true

    s6-setuidgid postgres ${PGBIN}/psql -d "${DB_DATABASE_NAME:-immich}" -p "${DB_PORT:-5432}" -c "CREATE EXTENSION IF NOT EXISTS vchord CASCADE;" 2>/dev/null || true

    s6-setuidgid postgres ${PGBIN}/pg_ctl -D "${PGDATA}" -m fast -w stop
    echo "[postgres] Initialization complete."
fi

# Idempotent re-apply of small-host tuning on pre-existing clusters.
# Marker-guarded so it only appends once; safe to run every boot.
if ! grep -q 'photoframe-immich small-host tuning' "${PGDATA}/postgresql.conf" 2>/dev/null; then
    echo "[postgres] Applying small-host tuning to existing cluster..."
    cat >> "${PGDATA}/postgresql.conf" <<'PGCONF'

# --- photoframe-immich small-host tuning ---
shared_buffers = 128MB
work_mem = 4MB
maintenance_work_mem = 64MB
effective_cache_size = 512MB
max_connections = 20
max_wal_size = 512MB
min_wal_size = 64MB
PGCONF
    chown postgres:postgres "${PGDATA}/postgresql.conf"
fi

mkdir -p /var/run/postgresql
chown postgres:postgres /var/run/postgresql

exec s6-setuidgid postgres ${PGBIN}/postgres \
    -D "${PGDATA}" \
    -p "${DB_PORT:-5432}" \
    -h "127.0.0.1" \
    -k /var/run/postgresql
